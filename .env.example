# Copy to .env for local runs. Never commit .env.
# In Azure these come from App Settings + Key Vault references, not from a file.

# ---------- Storage ----------
# LOCAL_STORAGE_ROOT makes the pipeline use a folder instead of Azure Blob.
# Leave it empty in Azure and set STORAGE_ACCOUNT_NAME instead.
LOCAL_STORAGE_ROOT=.localstore
STORAGE_ACCOUNT_NAME=
BLOB_LANDING_CONTAINER=landing
BLOB_PROCESSED_CONTAINER=processed
BLOB_QUARANTINE_CONTAINER=quarantine

# ---------- Database ----------
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=students
PG_USER=postgres
PG_PASSWORD=              # local only; Azure uses Managed Identity
PG_SSLMODE=prefer         # require in Azure
PG_USE_MANAGED_IDENTITY=false

# ---------- API source ----------
API_BASE_URL=http://localhost:8099
API_STUDENTS_PATH=/students
API_AUTH_TYPE=oauth2_client_credentials   # or static_token, see below
API_TOKEN_URL=http://localhost:8099/oauth2/token   # vendor-owned OAuth2 token endpoint
API_CLIENT_ID=local-client
API_CLIENT_SECRET=        # local only; Azure uses Key Vault
# API_STATIC_TOKEN=       # only used when API_AUTH_TYPE=static_token; not wired into
# Terraform/Key Vault yet, so this auth type is local/dev-only for now
API_TOKEN_EXPIRY_SKEW_SECONDS=30
API_PAGE_SIZE=100
API_TIMEOUT_SECONDS=30

# ---------- Schedules (NCRONTAB: sec min hour day month weekday) ----------
CSV_SCHEDULE_CRON=0 0 2 * * *
API_SCHEDULE_CRON=0 0 * * * *

# ---------- Retry ----------
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_SECONDS=1
RETRY_MAX_DELAY_SECONDS=60

# ---------- Processing ----------
CHUNK_SIZE=5000
RUN_STALE_AFTER_SECONDS=3600
LOG_LEVEL=INFO
APPLICATIONINSIGHTS_CONNECTION_STRING=
